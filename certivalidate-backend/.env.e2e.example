# Entorno para las pruebas de aceptación (pruebas_aceptacion/): BD local dedicada.
# Copiar como .env.e2e. Se carga ANTES de .env, así que estas variables tienen prioridad;
# con este archivo no hace falta tener .env (el de Supabase).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/certivalidate_e2e"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/certivalidate_e2e"

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
PUBLIC_VERIFY_URL=http://localhost:5173/verificar
LOG_LEVEL=warn

# Valores solo para pruebas locales
JWT_SECRET="e2e_jwt_secret_solo_para_pruebas_locales_123"
JWT_REFRESH_SECRET="e2e_refresh_secret_solo_para_pruebas_locales_456"
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_MODE=mock
BLOCKCHAIN_NETWORK=mock

# Correo (CA004 y CA013). Pedir la API key de Resend al equipo por un canal privado:
# nunca se sube al repositorio. Todos los correos van al buzón de prueba de Resend.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="onboarding@resend.dev"
EMAIL_DEV_TO="delivered@resend.dev"

# Contraseña del lector demo que crea `npm run seed` y que usa CA016 (pruebas_aceptacion/config.py)
SEED_ADMIN_PASSWORD="Admin1234!"
SEED_EMISOR_PASSWORD="Emisor1234!"
SEED_LECTOR_PASSWORD="Lector1234!"

# Las pruebas de aceptación hacen muchas solicitudes desde una sola IP
RATE_LIMIT_GENERAL_MAX=10000
